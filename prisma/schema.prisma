generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── CATALOGO / E-COMMERCE ─────────────────────────────────────

model Branch {
  id                  String              @id @default(cuid())
  code                String              @unique
  name                String
  address             String
  city                String
  state               String
  hours               String              @default("Lun-Sab 8:00-19:00")
  lat                 Float               @default(0)
  lng                 Float               @default(0)
  supportsPayAtBranch Boolean             @default(true)
  inventory           BranchInventory[]
  orders              Order[]
  reservations        InventoryReservation[]
}

model Product {
  id                   String              @id @default(cuid())
  sku                  String              @unique
  slug                 String              @unique
  brand                String
  model                String
  width                Int
  aspectRatio          Int
  rim                  Int
  loadIndex            String              @default("")
  speedRating          String              @default("")
  usage                String              @default("Touring")
  loadCapacity         String              @default("SL")
  traction             String              @default("A")
  temperature          String              @default("A")
  treadwear            Int                 @default(400)
  sidewall             String              @default("BSW")
  runFlat              Boolean             @default(false)
  plies                Int                 @default(4)
  maxLoadKg            Int                 @default(615)
  originalEquipment    String              @default("")
  priceCents           Int
  compareAtPriceCents  Int?
  satProductKey        String              @default("40111900")
  imageSvgSeed         Int                 @default(1)
  isFeatured           Boolean             @default(false)
  description          String              @default("")
  inventory            BranchInventory[]
  orderItems           OrderItem[]
  reservations         InventoryReservation[]
  erpMovements         ErpStockMovement[]
}

model Service {
  id            String      @id @default(cuid())
  code          String      @unique
  name          String
  priceCents    Int
  perUnit       Boolean     @default(true)
  satProductKey String      @default("78181500")
  satUnitKey    String      @default("E48")
  orderItems    OrderItem[]
}

model VehicleFitment {
  id          String @id @default(cuid())
  make        String
  model       String
  year        Int
  version     String @default("")
  width       Int
  aspectRatio Int
  rim         Int
}

model BranchInventory {
  id        String  @id @default(cuid())
  branchId  String
  productId String
  physical  Int
  reserved  Int     @default(0)
  version   Int     @default(0)
  branch    Branch  @relation(fields: [branchId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
}

model InventoryReservation {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  branchId  String
  qty       Int
  status    String   @default("ACTIVE")
  expiresAt DateTime
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  branch    Branch   @relation(fields: [branchId], references: [id])
}

// ─── ORDENES ────────────────────────────────────────────────────

model Order {
  id               String              @id @default(cuid())
  folio            String              @unique
  email            String              @default("cliente@demo.mx")
  phone            String              @default("")
  branchId         String
  fulfillment      String              @default("PICKUP")
  shippingAddress  String              @default("{}")
  status           String              @default("PENDIENTE_PAGO")
  paymentMethod    String              @default("TARJETA")
  subtotalCents    Int                 @default(0)
  discountCents    Int                 @default(0)
  shippingCents    Int                 @default(0)
  taxCents         Int                 @default(0)
  totalCents       Int                 @default(0)
  requiresInvoice  Boolean             @default(false)
  fiscalData       String              @default("{}")
  correlationId    String              @default("")
  couponCode       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  branch           Branch              @relation(fields: [branchId], references: [id])
  items            OrderItem[]
  payments         Payment[]
  reservations     InventoryReservation[]
  invoices         Invoice[]
  erpMovements     ErpStockMovement[]
  outboxEvents     OutboxEvent[]
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String?
  serviceId      String?
  qty            Int
  unitPriceCents Int
  parentItemId   String?
  order          Order    @relation(fields: [orderId], references: [id])
  product        Product? @relation(fields: [productId], references: [id])
  service        Service? @relation(fields: [serviceId], references: [id])
}

// ─── IDEMPOTENCIA ───────────────────────────────────────────────

model IdempotencyKey {
  id           String   @id @default(cuid())
  key          String   @unique
  requestHash  String
  status       String   @default("IN_PROGRESS")
  responseCode Int?
  responseBody String?
  orderId      String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

// ─── PAGOS ──────────────────────────────────────────────────────

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  provider          String   @default("MERCADOPAGO_SIM")
  providerPaymentId String   @default("")
  status            String   @default("PENDING")
  amountCents       Int
  method            String   @default("TARJETA")
  rawPayload        String   @default("{}")
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id])
}

model WebhookEvent {
  id              String    @id @default(cuid())
  providerEventId String    @unique
  type            String
  signatureValid  Boolean   @default(false)
  processedAt     DateTime?
  payload         String    @default("{}")
  createdAt       DateTime  @default(now())
}

// ─── ERP ────────────────────────────────────────────────────────

model ErpStockMovement {
  id                String   @id @default(cuid())
  externalRef       String   @unique
  productSku        String
  branchCode        String
  qty               Int
  type              String   @default("SALIDA_VENTA")
  erpDocumentNumber String
  createdAt         DateTime @default(now())
  product           Product  @relation(fields: [productSku], references: [sku])
  order             Order?   @relation(fields: [externalRef], references: [id])
}

// ─── FACTURACION ────────────────────────────────────────────────

model Invoice {
  id                     String    @id @default(cuid())
  orderId                String
  uuid                   String    @unique
  serie                  String    @default("RDX")
  folio                  String
  rfcEmisor              String    @default("EKU9003173C9")
  rfcReceptor            String
  nombreReceptor         String
  regimenFiscalReceptor  String
  cpReceptor             String
  usoCfdi                String    @default("G03")
  formaPago              String    @default("04")
  metodoPago             String    @default("PUE")
  subtotal               Int
  iva                    Int
  total                  Int
  xml                    String
  status                 String    @default("TIMBRADA")
  stampedAt              DateTime  @default(now())
  order                  Order     @relation(fields: [orderId], references: [id])
}

// ─── EVENTOS (CORAZON DE LA DEMO) ──────────────────────────────

model OutboxEvent {
  id            String    @id @default(cuid())
  type          String
  aggregateId   String
  correlationId String    @default("")
  payload       String    @default("{}")
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  createdAt     DateTime  @default(now())
  order         Order?    @relation(fields: [aggregateId], references: [id])
}

model AuditLog {
  id            String   @id @default(cuid())
  correlationId String   @default("")
  orderId       String?
  source        String   @default("CHECKOUT")
  level         String   @default("INFO")
  httpStatus    Int?
  message       String
  durationMs    Int?
  metadata      String   @default("{}")
  createdAt     DateTime @default(now())
}

// ─── CUPONES ────────────────────────────────────────────────────

model Coupon {
  id              String  @id @default(cuid())
  code            String  @unique
  discountPercent Int
  active          Boolean @default(true)
  maxUses         Int     @default(100)
  currentUses     Int     @default(0)
}
